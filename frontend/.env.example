# ---------------------------------------------------------------------------
# YieldVault frontend environment
# Copy to .env.local and fill in real values after deploying contracts.
# ---------------------------------------------------------------------------

# EVM ------------------------------------------------------------------------
# Which chain the UI treats as the default (31337 = local hardhat, 11155111 = sepolia)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337

# RPC endpoints
NEXT_PUBLIC_RPC_URL_LOCAL=http://127.0.0.1:8545
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://rpc.sepolia.org

# WalletConnect Cloud project id (only needed if you enable WalletConnect
# wallets in RainbowKit; the injected-wallet flow works without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses can also be supplied via env instead of editing
# src/config/contracts.ts (env wins when set).
NEXT_PUBLIC_USDC_VAULT_31337=
NEXT_PUBLIC_WETH_VAULT_31337=
NEXT_PUBLIC_WSOL_VAULT_31337=
NEXT_PUBLIC_USDC_TOKEN_31337=
NEXT_PUBLIC_WETH_TOKEN_31337=
NEXT_PUBLIC_WSOL_TOKEN_31337=
NEXT_PUBLIC_ETH_GATEWAY_31337=

NEXT_PUBLIC_USDC_VAULT_11155111=
NEXT_PUBLIC_WETH_VAULT_11155111=
NEXT_PUBLIC_WSOL_VAULT_11155111=
NEXT_PUBLIC_USDC_TOKEN_11155111=
NEXT_PUBLIC_WETH_TOKEN_11155111=
NEXT_PUBLIC_WSOL_TOKEN_11155111=
NEXT_PUBLIC_ETH_GATEWAY_11155111=

# Solana ---------------------------------------------------------------------
# RPC endpoint (local test validator by default)
NEXT_PUBLIC_SOLANA_RPC=http://127.0.0.1:8899
# Deployed sol_yield_vault program id. Leave empty until deployed; the UI
# shows a "not deployed" state when this is missing or invalid.
NEXT_PUBLIC_SOL_PROGRAM_ID=
